<?xml version="1.0"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>QuickFishing</AssemblyName>
    <Product>Quick Fishing</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>QuickFishing</RootNamespace>
    <Configuration>Release</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile"/>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
  </ItemGroup>
  <PropertyGroup>
    <GameDir>$(HOME)/.local/share/Steam/steamapps/common/Tales of Seikyu</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/*.dll" Private="False"/>
    <Reference Include="$(GameDir)/BepInEx/interop/*.dll" Private="False"/>
  </ItemGroup>
  <Target Name="CopyDLLs" AfterTargets="Build">
    <Message Text="Copying output..." Importance="High"/>
    <Copy SourceFiles="$(TargetDir)/$(ProjectName).dll" DestinationFolder="$(GameDir)/BepInEx/plugins/"/>
    <Message Text="Finished copying the output files." Importance="High"/>
  </Target>
</Project>
